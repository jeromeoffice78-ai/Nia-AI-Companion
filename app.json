{
  "expo": {
    "name": "Nia AI Companion",
    "slug": "nia-ai-companion",
    "scheme": "nia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.nia.companion",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-audio",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nia to show your front camera while you choose to use the camera preview.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
